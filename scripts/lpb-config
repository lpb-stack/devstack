#!/usr/bin/env python3
"""lpb-config — LocalPibox config repo manager.

Manages the config repo (~/.pi/agent) that ships inside the devstack image
and lives on the host volume. Stack/DevOps operations live in lpb-devstack.

Usage:
  lpb-config status          — Config repo HEAD, remote, local changes
  lpb-config update          — Fetch + fast-forward config repo (safe)
  lpb-config reset [--force] — Re-clone config repo (destructive)
  lpb-config merge           — Interactive git merge for config repo
  lpb-config render [--force] — Regenerate runtime config from templates
  lpb-config align           — Sync extension pins to latest GitHub tags
  lpb-config setup [--reconfigure] [--non-interactive]
                             Initial setup wizard (shared with 'lpb setup'):
                             config repo, lemonade provider, default model,
                             lpb-memory config — every step validated live
  lpb-config check           — Validate the installation (read-only)

  lpb-config memory show     — Show lpb-memory config
  lpb-config memory setup    — Interactive memory config wizard

Template rendering:
  The config repo ships templates (settings.json.template,
  lpb-memory-config.json.template); the rendered files are gitignored.
  start.sh generates them on first boot only (gated by ~/.pi/.initialized),
  so lpb-config re-renders after reset/update/merge and offers 'render'
  for on-demand regeneration. '--force' merges: user-added keys survive,
  template pins win in settings.json, local keys win in the memory config.

Moved to lpb-devstack (dev-time workspace tool):
  lpb-devstack bump | tag-repos | workspace ... | validate | release ...

`--tag dev|main` is still accepted (validates the value) for muscle memory;
the remaining commands operate on the config repo regardless of pipeline.

Environment:
  AGENT_DIR         — Config repo path (default: /home/lpb/.pi/agent)
  CONFIG_REMOTE     — Git remote URL (default: https://github.com/lpb-stack/config.git)
  CONFIG_REF        — Branch to track (default: main)
  LPB_GITHUB_TOKEN  — GitHub token for authenticated operations
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import urllib.request
from pathlib import Path

_SELF_DIR = Path(__file__).resolve().parent
# Shared localpibox package location — repo layout (support/ → <devstack>/scripts/),
# Docker image (/opt/pi-support), or host install (~/.lpb-stack/devstack/).
for _c in (
    _SELF_DIR.parent / "scripts",
    _SELF_DIR,
    Path("/opt/pi-support"),
    Path.home() / ".lpb-stack" / "devstack",
):
    if (_c / "localpibox").is_dir():
        sys.path.insert(0, str(_c))
        break

from localpibox.cli import confirm, install_sigpipe_handler  # noqa: E402
from localpibox.log import Console  # noqa: E402
from localpibox.run import run_cmd  # noqa: E402
from localpibox.setup import (  # noqa: E402
    AbortError,
    configure_memory,
    doctor as setup_doctor,
    lemonade_creds,
    run_wizard,
)
from localpibox.stack.gitutil import _github_token, git  # noqa: E402
from localpibox.stack.repos import (  # noqa: E402
    DEFAULT_AGENT_DIR,
    DEFAULT_REMOTE,
    DEFAULT_REF,
    LPB_EXTENSION_REPOS,
    migrate_legacy_layout,
)
from localpibox.stack.version import get_version  # noqa: E402

# ─── Config repo helpers ──────────────────────────────────────────────────

def clone_or_init(agent_dir: str | Path, remote: str, ref: str, cons: Console) -> bool:
    """Clone the config repo, or initialize it in place when the target is
    non-empty (stale runtime state). Mirrors the logic in start.sh."""
    agent_dir = Path(agent_dir)
    if agent_dir.is_dir() and any(agent_dir.iterdir()):
        cons.warn("Config area not empty — initializing config repo in place...")
        git(agent_dir, "init", "-q")
        out, err, code = git(agent_dir, "remote", "add", "origin", remote)
        if code:
            # Stale .git already has an origin (partial wipe) — repoint it.
            git(agent_dir, "remote", "set-url", "origin", remote)
        out, err, code = git(agent_dir, "fetch", "--depth=1", "origin", ref)
        if code:
            cons.error(f"Failed to fetch config repo: {err.strip() or out.strip()}")
            return False
        git(agent_dir, "reset", "-q", "--hard", f"origin/{ref}")
        return True
    out, err, code = run_cmd(
        ["git", "clone", "--depth=1", "--branch", ref, remote, str(agent_dir)],
        timeout=300,
    )
    if code:
        cons.error(f"Failed to clone config repo: {err.strip() or out.strip()}")
        return False
    return True


def head_short(dir_: str | Path) -> str:
    out, _, _ = git(dir_, "rev-parse", "HEAD")
    return out.strip()[:8] or "?"


# ─── Template rendering ───────────────────────────────────────────────────
# The config repo ships *templates*; the rendered runtime files are gitignored
# and start.sh only generates them on first boot (gated by ~/.pi/.initialized,
# which survives 'lpb-config reset'). So lpb-config must render itself after
# reset/update/merge — otherwise the rendered config is unrecoverable.

def _resolve_version() -> str:
    """Stack version for __LPB_VERSION__ substitution.

    Mirrors start.sh exactly: LPB_VERSION env (baked into the image) first,
    then the devstack VERSION file, then a safe fallback. (get_version() alone
    would prefer the workspace VERSION file, which may be a -dev version
    different from the baked image version.)
    """
    v = os.environ.get("LPB_VERSION", "").strip()
    if v:
        return v
    v = get_version()
    return v if v and v != "unknown" else "0.0.0-lpb"


def _stale_pins(packages, version: str) -> list[tuple[str, str]]:
    """(name, pin) pairs of lpb-stack packages whose pin != current version."""
    stale = []
    for pkg in packages or []:
        if not isinstance(pkg, str):
            continue
        m = re.search(r"lpb-stack/([^@/]+)@([^@]+)$", pkg)
        if m and m.group(2) != version:
            stale.append((m.group(1), m.group(2)))
    return stale


def _render_file(
    agent_dir: Path,
    template_name: str,
    out_name: str,
    cons: Console,
    *,
    force: bool,
    version: str | None,
    local_wins: bool,
) -> None:
    """Render one runtime config file from its template.

    - file missing        → generate from template (always safe)
    - present, no --force → never overwrite; report stale version pins and
      template packages not yet present locally
    - present, --force    → merge: keys present in both sides resolve by
      *local_wins* (memory config: the wizard is the customization path, so
      local wins; settings.json: template wins so pins track the stack
      version). Keys present in only one side are always preserved, and
      user-added packages are appended to the template's package list.
    """
    template = agent_dir / template_name
    out = agent_dir / out_name
    if not template.is_file():
        cons.warn(f"No {template_name} in {agent_dir} — skipped")
        return
    text = template.read_text()
    if version is not None:
        text = text.replace("__LPB_VERSION__", version)
    try:
        new = json.loads(text)
    except json.JSONDecodeError as e:
        cons.error(f"{template_name} is not valid JSON: {e}")
        return

    if not out.is_file():
        out.write_text(json.dumps(new, indent=2) + "\n")
        cons.info(f"Generated {out.name} from {template_name}")
        return

    try:
        existing = json.loads(out.read_text())
    except json.JSONDecodeError:
        existing = {}

    if not force:
        stale = _stale_pins(existing.get("packages"), version) if version else []
        if stale:
            cons.warn(f"{out.name}: extension pins are stale:")
            for name, pin in stale:
                cons.warn(f"  {name}: {pin} -> {version}")
            cons.warn("  'lpb-config render --force' will re-pin (user keys preserved).")
        else:
            missing = [
                p for p in (new.get("packages") or [])
                if p not in (existing.get("packages") or [])
            ]
            if missing:
                cons.warn(f"{out.name}: template adds packages not yet present locally:")
                for p in missing:
                    cons.warn(f"  {p}")
                cons.warn("  'lpb-config render --force' picks them up (user keys preserved).")
        return

    # --force: merge (see docstring for win rules)
    if (
        version is not None
        and isinstance(new.get("packages"), list)
        and isinstance(existing.get("packages"), list)
    ):
        tpl_pkgs = new["packages"]
        extras = [p for p in existing["packages"] if p not in tpl_pkgs]
        new = {**new, "packages": tpl_pkgs + extras}
    merged = {**new, **existing} if local_wins else {**existing, **new}
    out.write_text(json.dumps(merged, indent=2) + "\n")
    cons.info(f"Re-rendered {out.name} from {template_name} (merged, user keys preserved)")


def _render_templates(agent_dir: str | Path, cons: Console, *, force: bool) -> None:
    """Render all runtime config files from their templates."""
    agent_dir = Path(agent_dir)
    version = _resolve_version()
    _render_file(
        agent_dir, "settings.json.template", "settings.json", cons,
        force=force, version=version, local_wins=False,
    )
    _render_file(
        agent_dir, "lpb-memory-config.json.template", "lpb-memory-config.json", cons,
        force=force, version=None, local_wins=True,
    )


def cmd_render(agent_dir: str | Path, cons: Console, *, force: bool = False) -> int:
    """Render runtime config files from templates (safe: --force required to overwrite)."""
    agent_dir = Path(agent_dir)
    if not agent_dir.is_dir():
        cons.error(f"No config area at {agent_dir}. Run 'lpb-config update' first.")
        return 1
    cons.info(f"Rendering runtime config from templates (stack version: {_resolve_version()})")
    _render_templates(agent_dir, cons, force=force)
    cons.info("Re-run Pi (or /new) to apply.")
    return 0


# ─── Config repo commands ─────────────────────────────────────────────────

def cmd_status(agent_dir: str | Path, remote: str, ref: str, cons: Console) -> int:
    if not (Path(agent_dir) / ".git").is_dir():
        cons.warn(f"No config repo at {agent_dir}")
        cons.info("  Run 'lpb-config update' to clone it.")
        return 0

    cur = head_short(agent_dir)
    log = git(agent_dir, "log", "--oneline", "-1")[0].strip() or "?"
    cons.info(f"Current:     {cur} ({log})")

    out, _, code = git(agent_dir, "remote", "get-url", "origin")
    if code or not out.strip():
        cons.warn("No remote configured")
        return 0

    remote_head = git(agent_dir, "rev-parse", f"origin/{ref}")[0].strip()
    if remote_head:
        cons.info(f"Remote:      {remote_head[:8]} origin/{ref} (last fetch)")

    changes = git(agent_dir, "status", "--porcelain")[0]
    if changes.strip():
        cons.warn(f"Uncommitted changes detected ({len(changes.splitlines())} lines):")
        for line in changes.splitlines()[:10]:
            cons.raw(line)
    else:
        cons.info("Working tree: clean")

    if remote_head:
        _, _, code = git(agent_dir, "merge-base", "--is-ancestor", cur, remote_head)
        if code == 0:
            cons.info("Status:      up to date (or ahead)")
        else:
            cons.warn("Status:      behind remote — run 'lpb-config update' to fetch")
    return 0


def cmd_update(agent_dir: str | Path, remote: str, ref: str, cons: Console) -> int:
    if not (Path(agent_dir) / ".git").is_dir():
        cons.info(f"Cloning config repo from {remote}...")
        if not clone_or_init(agent_dir, remote, ref, cons):
            return 1
        _render_templates(agent_dir, cons, force=False)
        cons.info("Done. Run 'lpb-config status' to verify.")
        return 0

    cons.info(f"Fetching updates from {remote}...")
    out, err, code = git(agent_dir, "fetch", "origin", ref)
    if code:
        cons.error(f"Failed to fetch from {remote}: {err.strip() or out.strip()}")
        return 1

    remote_head = git(agent_dir, "rev-parse", f"origin/{ref}")[0].strip()
    cur_head = git(agent_dir, "rev-parse", "HEAD")[0].strip()
    if remote_head == cur_head:
        cons.info("Already up to date.")
        return 0

    changes = git(agent_dir, "status", "--porcelain")[0]
    if changes.strip():
        cons.warn("Uncommitted changes detected:")
        cons.raw(changes)
        cons.warn("Aborting — local changes would be lost.")
        cons.info("")
        cons.info("Options:")
        cons.info("  1. Commit your changes first, then re-run 'lpb-config update'")
        cons.info("  2. Use 'lpb-config reset' to discard local changes (destructive)")
        cons.info("  3. Use 'lpb-config merge' for an interactive git merge")
        return 1

    _, _, code = git(agent_dir, "merge-base", "--is-ancestor", cur_head, remote_head)
    if code == 0:
        git(agent_dir, "reset", "--hard", f"origin/{ref}")
        log = git(agent_dir, "log", "--oneline", "-1")[0].strip()
        cons.info(f"Updated to {log}")
        # Re-render runtime config so template changes (pins, new packages)
        # reach the live files. Non-forcing: user customizations survive.
        _render_templates(agent_dir, cons, force=False)
        return 0

    cons.warn("Cannot fast-forward — conflicts detected.")
    cons.info("")
    cons.info("Run 'lpb-config merge' for an interactive merge, or")
    cons.info("use 'lpb-config reset' to discard local changes (destructive).")
    return 1


def cmd_reset(
    agent_dir: str | Path,
    remote: str,
    ref: str,
    cons: Console,
    *,
    force: bool = False,
    inp=None,
) -> int:
    if not (Path(agent_dir) / ".git").is_dir():
        cons.info(f"Cloning config repo from {remote}...")
        if not clone_or_init(agent_dir, remote, ref, cons):
            return 1
        cons.info("Done.")
        return 0

    cons.warn(f"This will destroy ALL local changes in {agent_dir}.")
    cons.raw(f"  Current: {head_short(agent_dir)}")
    remote_head = git(agent_dir, "rev-parse", f"origin/{ref}")[0].strip()[:8]
    cons.raw(f"  Remote:  {remote_head}")

    if not force and not confirm("  Continue?", default=False, inp=inp):
        cons.info("Aborted.")
        return 0

    shutil.rmtree(agent_dir, ignore_errors=True)
    if agent_dir.is_dir():
        survivors = sorted(p.name for p in agent_dir.iterdir())
        if survivors:
            cons.warn(f"Wipe incomplete — {len(survivors)} entries survived "
                      "(in use or protected):")
            for n in survivors[:10]:
                cons.raw(f"  {n}")
            cons.warn("Re-initializing in place; untracked survivors are preserved.")
    if not clone_or_init(agent_dir, remote, ref, cons):
        return 1
    # Regenerate rendered runtime config from templates (they were wiped
    # with the repo). Force: reset is destructive by definition, and a
    # successful wipe means no rendered files survived to preserve.
    _render_templates(agent_dir, cons, force=True)
    cons.info("Reset complete. Runtime config regenerated from templates.")
    cons.info("Re-run Pi to apply the new config.")
    return 0


def cmd_merge(agent_dir: str | Path, remote: str, ref: str, cons: Console) -> int:
    if not (Path(agent_dir) / ".git").is_dir():
        cons.error(f"No config repo at {agent_dir}. Run 'lpb-config update' first.")
        return 1

    cons.info(f"Fetching latest from {remote}...")
    git(agent_dir, "fetch", "origin", ref)

    remote_head = git(agent_dir, "rev-parse", f"origin/{ref}")[0].strip()
    cur_head = git(agent_dir, "rev-parse", "HEAD")[0].strip()
    if remote_head == cur_head:
        cons.info("Already up to date.")
        return 0

    cons.info(f"Starting merge: {cur_head[:8]} -> {remote_head[:8]}")
    out, err, code = git(agent_dir, "merge", "--no-edit", f"origin/{ref}")
    if code == 0:
        cons.info("Merge complete.")
        _render_templates(agent_dir, cons, force=False)
        return 0

    cons.warn("Merge conflicts detected. Resolve them with git, then:")
    cons.info(f"  cd {agent_dir}")
    cons.info("  git add <resolved-files>")
    cons.info("  git commit")
    cons.info("  lpb-config status")
    return 1


def cmd_align(agent_dir: str | Path, remote: str, ref: str, cons: Console) -> int:
    """Align settings.json extension pins to latest available tags."""
    settings_path = Path(agent_dir) / "settings.json"
    if not settings_path.is_file():
        cons.error(f"settings.json not found: {settings_path}")
        return 1

    with open(settings_path) as f:
        settings = json.load(f)

    packages = settings.get("packages", [])
    lpb_repos = LPB_EXTENSION_REPOS

    current_pins = {}
    for pkg in packages:
        if isinstance(pkg, str) and "@" in pkg:
            for name in lpb_repos:
                if f"lpb-stack/{name}@" in pkg:
                    current_pins[name] = pkg.split("@")[-1]

    cons.info("Current extension pins:")
    for name in lpb_repos:
        cons.info(f"  {name}: {current_pins.get(name, '(not pinned)')}")

    cons.info("\nChecking latest tags...")
    token = _github_token()
    latest_tags = {}
    for name in lpb_repos:
        try:
            url = f"https://api.github.com/repos/lpb-stack/{name}/tags"
            headers = {"Accept": "application/vnd.github+json"}
            if token:
                headers["Authorization"] = f"Bearer {token}"
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                tags = json.loads(resp.read())
                if tags:
                    latest_tags[name] = tags[0]["name"]
        except Exception as e:
            cons.warn(f"  {name}: could not fetch ({e})")

    mismatches = []
    for name in lpb_repos:
        cur = current_pins.get(name)
        lat = latest_tags.get(name)
        if cur and lat and cur != lat:
            mismatches.append((name, cur, lat))

    if mismatches:
        cons.warn(f"\nVersion mismatch ({len(mismatches)} extension(s)):")
        for name, cur, lat in mismatches:
            cons.warn(f"  {name}: {cur} → {lat}")

        if confirm("\nUpdate settings.json to latest?"):
            for name, cur, lat in mismatches:
                old = f"git:github.com/lpb-stack/{name}@{cur}"
                new = f"git:github.com/lpb-stack/{name}@{lat}"
                idx = packages.index(old) if old in packages else -1
                if idx >= 0:
                    packages[idx] = new
                    cons.info(f"  {name}: {cur} → {lat}")
            settings["packages"] = packages
            with open(settings_path, "w") as f:
                json.dump(settings, f, indent=2)
                f.write("\n")
            cons.info(f"\nUpdated {settings_path}")
            cons.info("Note: settings.json is local state (gitignored) — the template")
            cons.info("pins are unchanged, and 'render --force' re-pins to the stack version.")
            cons.info("Run 'pi update --extensions' to apply")
        else:
            cons.info("Skipped. Run 'lpb-config align' when ready.")
    else:
        cons.info("\nAll extensions up to date")

    cons.info("\nConfig repo status:")
    out, err, code = git(agent_dir, "status", "--porcelain")
    if code == 0 and out.strip():
        cons.warn("Local changes detected:")
        for line in out.strip().split("\n")[:5]:
            cons.info(f"  {line}")
        cons.info("Use 'lpb-config update' to sync (if safe)")
        cons.info("Use 'lpb-config merge' for manual merge")
    else:
        cons.info("  Clean (no local changes)")

    return 0


# ─── Memory config commands ──────────────────────────────────────────────

def cmd_memory_show(agent_dir: str | Path, cons: Console) -> int:
    """Show current lpb-memory config."""
    path = Path(agent_dir) / "lpb-memory-config.json"
    if path.is_file():
        data = json.loads(path.read_text())
        cons.info("lpb-memory config:")
        cons.info(f"  File: {path}")
        cons.info("")
        for key, val in data.items():
            cons.info(f"  {key}: {val}")
    else:
        cons.warn(f"Config not found: {path}")
        if (Path(agent_dir) / "lpb-memory-config.json.template").is_file():
            cons.info("")
            cons.info("Template available, run to generate:")
            cons.info("  lpb-config memory setup --non-interactive")
        else:
            cons.info("")
            cons.info("Extension will use built-in defaults.")
    return 0


def cmd_memory_setup(*, agent_dir: str | Path, non_interactive: bool = False,
                     default_model: str | None = None, cons: Console) -> int:
    """Interactive memory config wizard (shared with the setup wizard)."""
    agent_dir = Path(agent_dir)
    interactive = not non_interactive and sys.stdin.isatty()
    if interactive:
        cons.info("=" * 50)
        cons.info("  lpb-memory Configuration")
        cons.info("=" * 50)
        cons.info("")
    try:
        ok = configure_memory(agent_dir, cons, interactive=interactive,
                              default_model=default_model or "")
    except AbortError:
        cons.warn("Memory setup aborted — nothing was written.")
        return 1
    if not ok:
        return 1
    cons.info("")
    cons.info("Apply: restart Pi session with /new")
    cons.info("Review: lpb-config memory show")
    return 0


# ─── Initial setup (shared wizard) + check ────────────────────────────────
#
# `lpb-config setup` is the container-side entry point of the SAME wizard
# that `lpb setup` runs on the host (localpibox.setup.run_wizard): config
# repo, lemonade provider, default model, lpb-memory config. Every step is
# validated live; failures loop (interactive) or abort with a precise error
# (non-interactive). start.sh runs the non-interactive form as a fallback
# when the host wizard did not run; the host wizard is primary.

def cmd_setup(*, agent_dir: str | Path, non_interactive: bool = False,
              reconfigure: bool = False, cons: Console) -> int:
    """Initial setup wizard (shared with 'lpb setup').

    Non-interactive + already configured + no --reconfigure → no-op
    (CI safety). Everything else runs the full wizard, which re-offers
    current values as defaults — the way to correct a bad configuration.
    """
    agent_dir = Path(agent_dir)
    creds = lemonade_creds(agent_dir)
    if creds is not None and not reconfigure and non_interactive:
        cons.info("Lemonade is already configured.")
        cons.info("Re-run with 'lpb-config setup --reconfigure' to change server or model.")
        return 0

    interactive = not non_interactive and sys.stdin.isatty()
    try:
        result = run_wizard(
            agent_dir=agent_dir,
            cons=cons,
            interactive=interactive,
            reconfigure=creds is not None,
            default_base_url=os.environ.get("LEMONADE_BASE_URL", ""),
            default_api_key=os.environ.get("LEMONADE_API_KEY", ""),
            config_remote=os.environ.get("CONFIG_REMOTE", ""),
            config_ref=os.environ.get("CONFIG_REF", "main"),
        )
    except AbortError:
        cons.warn("Setup aborted — nothing was written.")
        return 1
    if result.aborted:
        return 1
    if result.ok:
        for w in result.warnings:
            cons.warn(f"  ⚠ {w}")
        cons.info("Verify any time with: lpb-config check")
        return 0
    cons.error("Setup did not complete — nothing was persisted.")
    if result.error:
        cons.info(result.error)
    return 1


def cmd_check(*, agent_dir: str | Path, cons: Console) -> int:
    """Validate the installation (read-only checklist)."""
    return setup_doctor(agent_dir=agent_dir, cons=cons)


# ─── CLI ──────────────────────────────────────────────────────────────────

def _add_subparser(sub, name: str, help_: str) -> argparse.ArgumentParser:
    p = sub.add_parser(name, help=help_)
    return p


def main(argv: list[str] | None = None) -> int:
    install_sigpipe_handler()
    parser = argparse.ArgumentParser(
        prog="lpb-config",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Environment:\n"
            "  AGENT_DIR         Config repo path (default: /home/lpb/.pi/agent)\n"
            "  CONFIG_REMOTE     Git remote URL (default: https://github.com/lpb-stack/config.git)\n"
            "  CONFIG_REF        Branch to track (default: main)\n"
            "  LPB_GITHUB_TOKEN  GitHub token for authenticated git operations\n\n"
            "Pipeline:\n"
            "  Detected from VERSION file or LPB_IMAGE_TAG env var.\n"
            "  Override with --tag dev|main on any command.\n\n"
            "Dev/workspace operations live in lpb-devstack:\n"
            "  lpb-devstack bump | tag-repos | workspace ... | validate | release ..."
        ),
    )
    parser.add_argument(
        "--tag", default=None,
        help="Override pipeline detection (dev|main)",
    )

    sub = parser.add_subparsers(dest="command")

    # Config repo commands
    _add_subparser(sub, "status", "Show config repo commit, remote HEAD, local changes")
    _add_subparser(sub, "update", "Fetch + fast-forward config repo")
    p_reset = _add_subparser(sub, "reset", "Re-clone config repo (with confirmation)")
    p_reset.add_argument("--force", action="store_true", help="skip confirmation")
    _add_subparser(sub, "merge", "Open git merge flow for config repo")
    p_render = _add_subparser(
        sub, "render",
        "Render runtime config from templates (settings.json, lpb-memory config)",
    )
    p_render.add_argument(
        "--force", action="store_true",
        help="overwrite existing rendered files (merged — user keys preserved)",
    )
    _add_subparser(sub, "align", "Align settings.json extension pins to latest tags")

    # First-run setup (provider + default model + memory)
    p_setup = _add_subparser(
        sub, "setup",
        "Initial setup wizard (shared with 'lpb setup'): provider, model, memory",
    )
    p_setup.add_argument("--reconfigure", action="store_true",
                         help="reconfigure even if lemonade is already set up")
    p_setup.add_argument("--non-interactive", action="store_true",
                         help="no prompts (LEMONADE_BASE_URL/LEMONADE_API_KEY env + defaults)")
    _add_subparser(sub, "check", "Validate the installation (read-only checklist)")

    # Memory config subcommand
    p_mem = sub.add_parser("memory", help="Manage lpb-memory extension config")
    mem_sub = p_mem.add_subparsers(dest="memory_command")
    _add_subparser(mem_sub, "show", "Show current lpb-memory config")
    p_mem_setup = _add_subparser(mem_sub, "setup", "Interactive memory config wizard")
    p_mem_setup.add_argument("--non-interactive", action="store_true",
                             help="generate from template without prompts")

    args = parser.parse_args(argv)

    agent_dir = os.environ.get("AGENT_DIR", DEFAULT_AGENT_DIR)
    remote = os.environ.get("CONFIG_REMOTE", DEFAULT_REMOTE)
    ref = os.environ.get("CONFIG_REF", DEFAULT_REF)
    cons = Console()

    if args.tag is not None and args.tag not in ("dev", "main"):
        cons.error(f"invalid --tag: {args.tag} (expected dev|main)")
        return 1

    if agent_dir == DEFAULT_AGENT_DIR:
        migrate_legacy_layout("/home/lpb/.pi", DEFAULT_AGENT_DIR, cons)

    force = getattr(args, "force", False) or os.environ.get("FORCE") == "1"

    if args.command == "status":
        return cmd_status(agent_dir, remote, ref, cons)
    if args.command == "update":
        return cmd_update(agent_dir, remote, ref, cons)
    if args.command == "reset":
        return cmd_reset(agent_dir, remote, ref, cons, force=force)
    if args.command == "merge":
        return cmd_merge(agent_dir, remote, ref, cons)
    if args.command == "render":
        return cmd_render(agent_dir, cons, force=force)
    if args.command == "align":
        return cmd_align(agent_dir, remote, ref, cons)
    if args.command == "setup":
        return cmd_setup(agent_dir=agent_dir,
                         non_interactive=getattr(args, "non_interactive", False),
                         reconfigure=getattr(args, "reconfigure", False), cons=cons)
    if args.command == "check":
        return cmd_check(agent_dir=agent_dir, cons=cons)
    if args.command == "memory":
        if not args.memory_command:
            p_mem.print_help()
            return 1
        if args.memory_command == "show":
            return cmd_memory_show(agent_dir, cons)
        if args.memory_command == "setup":
            non_int = getattr(args, "non_interactive", False)
            return cmd_memory_setup(agent_dir=agent_dir, non_interactive=non_int, cons=cons)

    parser.print_help()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
