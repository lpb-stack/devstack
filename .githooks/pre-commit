#!/bin/bash
# pre-commit hook — Validate devstack state before commit
#
# Thin wrapper: stack-state checks (VERSION, LPB_PI_VERSION, extension pins,
# workspace branch alignment, pipeline consistency) live in ONE place —
# the workspace's own validate module, so the hook always runs the
# CURRENT logic (the PATH lpb-devstack is the image-baked copy and stays
# stale until the next rebuild):
#   python3 scripts/lpb-devstack validate   (scripts/localpibox/stack/validate.py)
# This hook adds only the lpb.py unit tests.
#
# Escape hatches:
#   SKIP_TESTS=1 git commit ...   — skip unit tests (~4s)
#   git commit --no-verify ...    — skip everything

echo "=== lpb-devstack validate (workspace copy) ==="
if ! python3 scripts/lpb-devstack validate; then
    echo ""
    echo "❌ Pre-commit FAILED — validation did not pass"
    echo "   Fix the issues above and retry, or use --no-verify to skip"
    exit 1
fi
echo ""

# lpb.py unit tests
echo "=== Python Tests ==="
if [ -n "$SKIP_TESTS" ]; then
    echo "  (skipped via SKIP_TESTS)"
elif ! python3 scripts/test_lpb.py 2>&1 | tail -3; then
    echo ""
    echo "❌ Pre-commit FAILED — test_lpb.py failed"
    echo "   Fix tests before committing, or use SKIP_TESTS=1 to bypass"
    exit 1
fi
echo ""
echo "✅ Pre-commit passed"
