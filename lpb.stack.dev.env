# lpb.stack.dev.env — Dev profile configuration
#
# Points to development branches for testing (config: dev).
# Used when running: lpb --tag dev

# ─── Pi (mainstream, from npm registry) ────────────────────────────────
# Pinned npm version — same for both pipelines (upstream has no dev/stable
# split; the version IS the stability signal). Bump in lpb.stack.env AND
# here together.
LPB_PI_VERSION=0.84.4

# ─── Config Preset ───────────────────────────────────────────────────────
LPB_CONFIG_REF=dev
