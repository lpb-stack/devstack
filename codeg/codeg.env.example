# goose-as-ACP env for the codeg container (docker --env-file format: KEY=VALUE, no quotes)
# Values verified against strixite + goose-acp 1.57.0 (devstack#18, 2026-11-04).
# Stack follow-up: this file should be generated by `lpb-config render` (goose.env).

GOOSE_PROVIDER=openai
GOOSE_MODEL=qwen3.8-flash-next

# Built-in OpenAI provider against the strixite endpoint:
#   OPENAI_HOST      = scheme://host:port (no trailing path)
#   OPENAI_BASE_PATH = the path it serves
OPENAI_HOST=http://192.168.0.13:8000
OPENAI_BASE_PATH=v1/chat/completions

# Truthful context window (goose otherwise falls back to a 128k catalog default
# for models it does not know, silently capping compaction and thinking budget).
GOOSE_CONTEXT_LIMIT=524288

# Response ceiling — mirrors the stack's proven-safe ceiling for thinking models.
GOOSE_MAX_TOKENS=16384

# Compaction: the absolute trigger binds before the 0.8 percentage one
# (0.8 x 524288 = 419430 > 200000). Keep below (window / server slots=2) so
# concurrent sessions cannot collectively overrun the KV budget.
GOOSE_AUTO_COMPACT_TOKEN_LIMIT=200000
GOOSE_CONTEXT_STRATEGY=summarize

# Tool execution: auto = approve tool calls without asking.
GOOSE_MODE=auto
GOOSE_TELEMETRY_ENABLED=false
